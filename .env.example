# Settings names only — copy to .env and fill in. Never commit real secrets.

# --- storage ---------------------------------------------------------------
DATABASE_URL=postgresql://ca:ca@127.0.0.1:55432/change_analysis
APP_STORAGE_SECRET=change-me-please-a-long-random-string

# --- paths -----------------------------------------------------------------
# Where the delivered run directories live (one directory per run, containing
# manifest.json and RESULTS/BEFORE_MASTER, RESULTS/AFTER_BETA).
DATASET_ROOT=
# Where user-supplied .py procedures live (the "file" source of a procedure).
SCRIPT_ROOT=
# Where temporary/permanent stage artifacts are written.
ARTIFACT_ROOT=

# --- compute ---------------------------------------------------------------
COMPUTE_PYTHON=
COMPUTE_BACKEND=cpu          # cpu | gpu
STAGE_TIMEOUT_SEC=1800

# --- worker ----------------------------------------------------------------
HEARTBEAT_SEC=5
LEASE_SEC=120

# --- web -------------------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080

# --- LLM second opinion (optional; the app works without it) ---------------
# LLM_PROVIDER=openai-compatible
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_API_KEY_ENV=LLM_API_KEY      # name of the env var, not the key itself
# LLM_TIMEOUT_SEC=60
# LLM_MAX_PAYLOAD_CHARS=24000
# how many deterministically sampled evidence rows may be sent to the model
LLM_MAX_EVIDENCE=40
